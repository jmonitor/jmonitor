{
	admin localhost:2019
	metrics
	# other global options…

	frankenphp {
		num_threads 8
		# Extra threads are spawned on demand during spikes and released after
		# max_idle_time (5s by default). 16 × memory_limit (128M) = 2G in theory,
		# actual usage stays well below that.
		max_threads 16
		# No free thread after 10s → 504, rather than queueing requests
		# indefinitely and snowballing.
		max_wait_time 10s
	}
}

:8080 {
	root * public/
	encode zstd br gzip

	header {
		X-Content-Type-Options "nosniff"
	}

	mercure {
		transport local

		# Identifier, audience and cookie name: config/packages/mercure.yaml. Key
		# injected through an env var ({$VAR} = substituted when the Caddyfile is
		# parsed), the app's MERCURE_JWT_SECRET.
		issuer jmonitor {
			publisher {
				jwt {$MERCURE_JWT_SECRET} HS256
			}
			subscriber {
				jwt {$MERCURE_JWT_SECRET} HS256
			}
		}
		resource_identifier https://jmonitor.io/.well-known/mercure
		cookie_name mercure_access_token

		# Public embeds subscribe without a token; dashboard updates are private.
		anonymous

		# No cors_origins/publish_origins: the browser subscribes same-origin (the
		# hub is served by this site) and the app publishes with a bearer token.

		# Exposes the subscription web API and dispatches private updates when a
		# subscription between the hub and a subscriber opens or closes. Not needed here.
		# subscriptions
	}

	php_server {
		worker {
			file ./public/index.php
			num 4
			# Labels the worker's Prometheus metrics and logs
			# (read by our own Caddy collector).
			name jmonitor
		}
	}
}
