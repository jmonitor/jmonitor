APP_EDITION=cloud

# IANA timezone of the stack (self-hosted knob, validated by app:install).
# The cloud edition never reads it — its PHP timezone is pinned by php.ini
# (date.timezone = Europe/Paris); this value mirrors it for coherence.
# Self-hosted Docker always overrides it (compose injects TZ, default UTC).
TZ=Europe/Paris

# Root domain: the collector, dash, admin... hosts are derived from this value.
APP_DOMAIN=jmonitor.io
# ":-" default: also keeps `docker compose` quiet (it interpolates .env and would warn
# about the unset Clever Cloud variable on every dev command).
TRUSTED_PROXIES="private_ranges,127.0.0.1,${CC_REVERSE_PROXY_IPS:-}"

REDIS_SESSION_DSN=
REDIS_CACHE_DSN=

# Sender identity for outgoing emails. Self-hosted instances set their OWN address.
MAILER_SENDER_EMAIL=

# Recipient of prod error emails (monolog error_mailer handler, when@prod).
# EMPTY => NullHandler (no email, errors stay in the logs).
ERROR_MAIL_TO=

# Sender of alert emails. EMPTY => falls back to MAILER_SENDER_EMAIL
# (only one address to configure).
ALERT_MAIL_FROM=

MERCURE_SUBSCRIBER_JWT_KEY=

# OAuth social login — optional, empty = non-functional button.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

###> symfony/framework-bundle ###
APP_ENV=dev
# Generate with: php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI="https://${APP_DOMAIN}"
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
DATABASE_URL=
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# SMTP recommended: smtp://USER:PASSWORD@host:587 (URL-encoded passwords).
# null://null = no sending (emails are silently discarded).
MAILER_DSN=null://null
###< symfony/mailer ###

###> symfony/mercure-bundle ###
# See https://symfony.com/doc/current/mercure.html#configuration
# The URL of the Mercure hub, used by the app to publish updates (can be a local URL)
MERCURE_URL=
# No public URL: the browser subscribes same-origin (App\Bridge\Mercure\SameOriginHub).
# The secret used to sign the JWTs (>= 32 octets, HMAC-SHA256)
MERCURE_JWT_SECRET=
###< symfony/mercure-bundle ###

###> influxdata/influxdb-client-php ###
INFLUXDB_URL=
INFLUXDB_TOKEN=
# Optional: when empty, resolved from INFLUXDB_ORG_NAME via the API at first use.
INFLUXDB_ORG_ID=
INFLUXDB_ORG_NAME=
###< influxdata/influxdb-client-php ###

###> jmonitor/jmonitor-bundle ###
# API key of the self-monitoring project (the app monitors itself).
JMONITOR_API_KEY=
###< jmonitor/jmonitor-bundle ###

# Self-hosted only: set to 0 to disable the out-of-the-box self-monitoring project (see docker/selfhosted/README.md).
SELF_MONITORING=1

###> sentry/sentry-symfony ###
# Optional: empty = Sentry disabled.
SENTRY_DSN=
###< sentry/sentry-symfony ###

###> stripe/stripe-php ###
# Cloud edition only (APP_EDITION=cloud): empty = billing disabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_MAX_MONTHLY_PRICE_ID=
STRIPE_PORTAL_URL=
###< stripe/stripe-php ###

###> app:install (self-hosted) ###
# Initial admin account, created at first start only when no admin exists yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Compose-stack bootstrap values (consumed by mysql/influxdb containers, not the app); only checked here for leftover placeholders.
MYSQL_ROOT_PASSWORD=
INFLUXDB_ADMIN_PASSWORD=
###< app:install (self-hosted) ###
