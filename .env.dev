# Dev defaults for the Docker Compose stack (compose.yaml).
# Everything here is a throwaway dev-only value, safe to commit.
# Personal overrides (e.g. JMONITOR_API_KEY) go to .env.dev.local (gitignored).

APP_DOMAIN=jmonitor.localhost
# Dev-only secret. Real deployments generate their own (see .env).
APP_SECRET=aa2bf508d4d2b28ebbbdcb28e4d4fac6

DATABASE_URL="mysql://root:root@mysql:3306/jmonitor?serverVersion=8.0.46&charset=utf8mb4"

REDIS_SESSION_DSN=redis://redis:6379/1
REDIS_CACHE_DSN=redis://redis:6379/0

MAILER_DSN=null://null

# Self-monitoring pushes to this instance's own collector host (a compose network
# alias on the app container). The key matches the dev project provisioned by
# `make setup` (app:dev:provision); override it in .env.dev.local to target
# another project. Run the collect loop with `make monitor`.
JMONITOR_COLLECTOR_URL=http://collector.jmonitor.localhost
JMONITOR_API_KEY=dev-selfmonitoring-key

# Mercure hub embedded in the app container's Caddy (docker/dev/Caddyfile), like prod.
# Server-side publishing goes through the compose service name so it resolves to the
# app container from every container (app and demo alike). A *.localhost name would
# NOT work here: libcurl force-resolves those to loopback (RFC 6761), bypassing Docker
# DNS. The browser subscribes through the public dash host — same server, no proxying.
MERCURE_URL=http://app/.well-known/mercure
# Must match publisher_jwt/subscriber_jwt in docker/dev/Caddyfile
# (>= 32 bytes: lcobucci/jwt enforces an HMAC-SHA256 key of at least 256 bits).
MERCURE_JWT_SECRET="!ChangeThisDevMercureSecret-min-32-bytes!"

# Provisioned by the influxdb service in compose.yaml (DOCKER_INFLUXDB_INIT_*).
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=dev-influxdb-admin-token
INFLUXDB_ORG_NAME=jmonitor
# Empty: resolved from INFLUXDB_ORG_NAME via the API (see App\Bridge\InfluxDb).
INFLUXDB_ORG_ID=
