# Prod overrides (Clever Cloud). NO SECRET HERE: this file is versioned.
# Prod secrets are Clever Cloud environment variables (console > Env).
#
# The ${MYSQL_ADDON_*} variables are injected automatically by the MySQL
# add-on linked to the app. Interpolation is resolved by "composer dump-env prod"
# at build time, where these variables exist.
# NB: this hook does not run on a "from cache" deployment — after an add-on
# credentials rotation, redeploy with a rebuild.
DATABASE_URL="${MYSQL_ADDON_URI}?serverVersion=${MYSQL_ADDON_VERSION}&charset=utf8mb4"

# Same with the Redis add-on (REDIS_HOST / REDIS_PORT / REDIS_PASSWORD).
# NB: assumes a password with no character needing URL-encoding (Clever Cloud case).
REDIS_SESSION_DSN="redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}?timeout=2&read_timeout=0.5"
REDIS_CACHE_DSN="redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}?timeout=2&read_timeout=0.5"
MESSENGER_TRANSPORT_DSN="redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/messages?timeout=0.5&read_timeout=30"
