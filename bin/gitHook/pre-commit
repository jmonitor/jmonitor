#!/bin/bash

# No PHP? Exit gracefully
if ! command -v php &>/dev/null; then
    exit 0
fi

PROJECT=$(git rev-parse --show-toplevel)
SFILES=$(git diff --cached --name-only --diff-filter=ACMR HEAD | grep '\.php$')
TWIGFILES=$(git diff --cached --name-only --diff-filter=ACMR HEAD | grep '\.twig$')
ENTITY_FILES=$(git diff --cached --name-only --diff-filter=ACMR HEAD | grep -E '(Entity|migrations)/')

# PHP Lint + CS Fixer + PHPStan
if [ -n "$SFILES" ]; then
    printf "Running PHP Lint... "
    FILES=()
    for FILE in $SFILES; do
        if ! php -l -d display_errors=0 "$PROJECT/$FILE" > /dev/null 2>&1; then
            php -l "$PROJECT/$FILE"
            exit 1
        fi
        FILES+=("$PROJECT/$FILE")
    done
    echo "passed"

    # PHP CS Fixer
    printf "Running PHP CS Fixer... "
    if ./vendor/bin/php-cs-fixer check --quiet --config=.php-cs-fixer.dist.php "${FILES[@]}" > /dev/null 2>&1; then
        echo "passed"
    else
        echo "Errors detected. Running fix..."
        ./vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --quiet "${FILES[@]}" > /dev/null
        git add "${FILES[@]}"
        printf "Running PHP CS Fixer again... "
        output=$(./vendor/bin/php-cs-fixer check --config=.php-cs-fixer.dist.php --diff "${FILES[@]}")
        if [ $? = 0 ]; then
            echo "passed"
        else
            echo "Errors not fixable automatically:"
            echo "$output"
            exit 1
        fi
    fi

    # PHPStan
    printf "Running PhpStan... "
    output=$(./vendor/bin/phpstan analyze --no-progress --memory-limit=512M)
    if [ $? != 0 ]; then
        echo ""
        echo "$output"
        exit 1
    else
        echo "passed"
    fi

    # Doctrine schema validation — only when entities or migrations changed.
    # Runs in the app container: it needs pdo_mysql + the dev database, which
    # host PHP doesn't have since the Docker dev environment migration.
    if [ -n "$ENTITY_FILES" ]; then
        printf "Validate entities mapping... "
        if ! docker compose ps -q --status running app 2>/dev/null | grep -q .; then
            echo "skipped (app container not running)"
        elif docker compose exec -T app php bin/console doctrine:schema:validate -q; then
            echo "passed"
        else
            docker compose exec -T app php bin/console doctrine:schema:validate
            echo "Fix the error before commit."
            exit 1
        fi
    fi
fi

# Twig lint — runs when twig files are staged (independent of PHP files)
if [ -n "$TWIGFILES" ]; then
    printf "Running twig lint... "
    if ./vendor/bin/twig-cs-fixer lint ./templates > /dev/null 2>&1; then
        echo "passed"
    else
        echo "Errors detected. Running fixer..."
        ./vendor/bin/twig-cs-fixer lint --fix ./templates > /dev/null
        git add $TWIGFILES
        printf "Running twig lint again... "
        output=$(./vendor/bin/twig-cs-fixer lint ./templates)
        if [ $? = 0 ]; then
            echo "passed"
        else
            echo "Errors not fixable automatically:"
            echo "$output"
            exit 1
        fi
    fi
fi

exit 0
