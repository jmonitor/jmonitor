# JMonitor self-hosted configuration.
#   cp .env.example .env        then fill in every CHANGE_ME value.
# Generate secrets with:  openssl rand -hex 32
# The app refuses to start while a CHANGE_ME placeholder remains.

# ── Domain ───────────────────────────────────────────────────────────────────
# Root domain of your instance. The app serves three subdomains of it:
# dash.<domain> (dashboard), collector.<domain> (metrics API), admin.<domain>.
# DNS + reverse proxy setup: see README.md.
APP_DOMAIN=monitoring.example.com

# Local HTTP port your reverse proxy forwards to (bound to 127.0.0.1 by default).
JMONITOR_HTTP_PORT=8080
# Reverse proxy on another machine? Bind on all interfaces instead — and firewall the port.
# JMONITOR_HTTP_BIND=0.0.0.0

# Image tag to run: a release version (e.g. 1.2.0) or latest.
JMONITOR_VERSION=latest

# ── Secrets ──────────────────────────────────────────────────────────────────
# openssl rand -hex 16
APP_SECRET=CHANGE_ME
# openssl rand -hex 32 — signs the Mercure JWTs (min 32 characters).
MERCURE_JWT_SECRET=CHANGE_ME
# openssl rand -hex 16
MYSQL_ROOT_PASSWORD=CHANGE_ME
# openssl rand -hex 32 — InfluxDB operator token, used by the app.
INFLUXDB_TOKEN=CHANGE_ME
# openssl rand -hex 16 — InfluxDB UI login (admin / this password).
INFLUXDB_ADMIN_PASSWORD=CHANGE_ME

# ── Initial admin account ────────────────────────────────────────────────────
# Created at first start, only when no admin exists yet.
ADMIN_EMAIL=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Alert notifications AND production error reports go through email. Without
# SMTP the app runs, but alert emails are lost and errors only land in the
# container logs (docker compose logs app).
# Example: smtp://user:password@smtp.example.com:587 (URL-encode the password).
MAILER_DSN=null://null
# Sender address of outgoing emails.
MAILER_SENDER_EMAIL=you@example.com
# Recipient of production error reports. Empty = no error emails.
ERROR_MAIL_TO=

# ── Timezone ─────────────────────────────────────────────────────────────────
# IANA identifier (e.g. Europe/Paris) applied to the whole stack: server-rendered
# dates, emails, logs, MySQL. Charts always render in each visitor's browser
# timezone regardless. Set it once at install: changing it later shifts the
# interpretation of dates already stored in the database.
TZ=UTC

# ── Optional ─────────────────────────────────────────────────────────────────
# Reverse proxy on another machine? Add its IP so Forwarded headers are trusted
# (a proxy on the same host is already covered by the private-ranges default).
# TRUSTED_PROXIES=private_ranges,127.0.0.1,203.0.113.10

# Your instance monitors itself out of the box (project "jmonitor", collector
# service). Set to 0 BEFORE the first start to disable it — see README.md.
# SELF_MONITORING=0
