# Caddyfile of the self-hosted image. Mirrors production (repo root Caddyfile):
# FrankenPHP worker mode, same-process Mercure hub, admin API on :2019 (the
# image healthcheck and the caddy collector target it).
#
# Two TLS modes, selected by JMONITOR_SITE_ADDRESS (see README.md):
# - default (:80): plain HTTP, TLS terminates at the self-hoster's reverse proxy.
# - native HTTPS (compose.https.yaml): the address lists the three public hosts,
#   Caddy obtains/renews the certificates itself (Let's Encrypt, or its internal
#   CA via JMONITOR_TLS); compose-internal traffic moves to the :2021 site below.
# Symfony routes by Host header (config/routes.yaml), so one site block serves
# dash. / collector. / admin. in both modes.
{
	admin localhost:2019
	metrics

	frankenphp {
		num_threads {$FRANKENPHP_NUM_THREADS:8}
		# Extra threads spawned on demand during spikes, released after
		# max_idle_time (5s default). 16 × memory_limit (256M) = 4G worst
		# case; real usage stays far below.
		max_threads {$FRANKENPHP_MAX_THREADS:16}
		# No free thread within 10s → 504, instead of queueing requests
		# indefinitely (snowball effect).
		max_wait_time 10s
	}
}

{$JMONITOR_SITE_ADDRESS::80} {
	root * public/
	encode zstd br gzip

	# Native HTTPS mode only, empty otherwise: "tls internal" (Caddy's local CA,
	# for private networks) or "tls /path/cert.pem /path/key.pem" (own certs).
	{$JMONITOR_TLS:}

	header {
		X-Content-Type-Options "nosniff"
	}

	mercure {
		transport local

		# Same env var as the app (config/packages/mercure.yaml).
		publisher_jwt {$MERCURE_JWT_SECRET} HS256
		subscriber_jwt {$MERCURE_JWT_SECRET} HS256

		# No cors_origins/publish_origins: browsers subscribe same-origin (the hub is
		# served by this very site, whatever scheme and port the user publishes it on)
		# and the app publishes with a bearer token.
	}

	php_server {
		worker {
			file ./public/index.php
			num {$FRANKENPHP_WORKER_COUNT:4}
			# Labels the worker's Prometheus metrics and logs (scraped by
			# the self-monitoring caddy collector).
			name jmonitor
		}
	}
}

# Prometheus metrics for the self-monitoring collector service (compose network
# only: the port is not published). The admin API stays on localhost:2019.
:2020 {
	metrics /metrics
}

# Compose-internal plain-HTTP site (port never published): in native HTTPS
# mode compose.https.yaml points Mercure publishing, php-metrics and the
# self-monitoring pushes here; in the default HTTP mode they use :80 and this
# site sits unused. Plain php_server on purpose: FrankenPHP sums `worker`
# pools across listeners, so a worker here would double PHP memory for a
# handful of internal requests per minute. The mercure handler shares the main
# site's hub (the module pools transports process-wide), so events published
# here reach browsers subscribed through the public site.
http://app:2021 {
	root * public/

	mercure {
		transport local
		publisher_jwt {$MERCURE_JWT_SECRET} HS256
		subscriber_jwt {$MERCURE_JWT_SECRET} HS256
	}

	php_server
}
