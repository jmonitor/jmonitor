<!DOCTYPE html>
<html lang="{{ app.locale }}" data-bs-theme="dark">
    <head>
        <meta charset="UTF-8">
        <title>{{ block('title') is defined ? block('title') ~ ' | Jmonitor' : 'Jmonitor' }}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        {{ importmap('app') }}
        <meta name="apple-mobile-web-app-title" content="Jmonitor" />
        <meta name="turbo-cache-control" content="no-preview">
        <meta name="turbo-prefetch" content="false">
        <meta name="turbo-refresh-scroll" content="preserve">

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono&family=IBM+Plex+Sans:ital,wght@0,300..600;1,300..600&family=Outfit:wght@300..600&display=swap" rel="stylesheet">

        <link rel="icon" href="{{ asset('im/favicons/logo-96x96.png') }}" sizes="96x96" type="image/png">
        <link rel="icon" type="image/svg+xml" href="{{ asset('im/favicons/logo.svg') }}" />
        <link rel="shortcut icon" href="{{ asset('im/favicons/favicon.ico') }}" />
        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('im/favicons/apple-touch-icon.png') }}" />
        <link rel="manifest" href="{{ path('app.manifest') }}" />

        {{ include('common/_metas.html.twig') }}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
            <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
            <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
            <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    {% block body %}{% endblock %}
</html>
