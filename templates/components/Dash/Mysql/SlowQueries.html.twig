<div class="card">
    <div class="card-header">Slowest queries</div>
    <div class="card-body">
        {% if slowQueries %}
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Query</th>
                        <th>avg time</th>
                        <th>total time</th>
                        <th>nb exec</th>
                        <th>db name</th>
                    </tr>
                </thead>
                <tbody>
                    {% for query in slowQueries %}
                        <tr>
                            <td>{{ query.query }}</td>
                            <td>{{ query.avg_time_ms }}ms</td>
                            <td>{{ query.total_time_ms }}ms</td>
                            <td>{{ query.execution_count }}</td>
                            <td>{{ query.db_name }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
            NO DATAS
        {% endif %}
    </div>
</div>
