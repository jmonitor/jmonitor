<twig:Card {{ ...attributes }}>
    <div class="d-flex align-items-center gap-2 mb-4">
        <twig:ux:icon name="material-symbols:ecg-heart" width="1.5em" height="1.5em" class="text-primary"/>
        <h6 class="card-title mb-0">Collector status</h6>
        <twig:Html:Badge:Badge badge="{{ lastPushStatus.badge }}" class="ms-auto" />
    </div>

    {% if lastPush %}
        <twig:Metric:Metric:List>
            <twig:InfoLine label="Collector version" truncate="{{ false }}">
                <span class="d-inline-flex align-items-center gap-2">
                    {{ collectorVersion.display }}
                    <turbo-frame id="version-update-collector" src="{{ path('project.version.update', {uuid: current_project().uuid, package: 'collector'}) }}"></turbo-frame>
                </span>
            </twig:InfoLine>

            {% if not bundleVersion.absent %}
                <twig:InfoLine label="Bundle version" truncate="{{ false }}">
                    <span class="d-inline-flex align-items-center gap-2">
                        {{ bundleVersion.display }}
                        <turbo-frame id="version-update-bundle" src="{{ path('project.version.update', {uuid: current_project().uuid, package: 'bundle'}) }}"></turbo-frame>
                    </span>
                </twig:InfoLine>
            {% endif %}
            <twig:InfoLine label="Last push">
                <span {{ stimulus_controller('relative-time', {timestamp: lastPush.lastPushAt.timestamp}) }}></span>
            </twig:InfoLine>
        </twig:Metric:Metric:List>
    {% else %}
        <twig:Metric:Metric:List>
            <twig:InfoLine label="Last push">
                {{ current_project().lastDataPushDate?.format('Y-m-d') }}
            </twig:InfoLine>
        </twig:Metric:Metric:List>
    {% endif %}
</twig:Card>
