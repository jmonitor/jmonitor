{% if cancelUrl %}
    <div class="d-flex align-items-center gap-3">
        <button type="submit" {{ attributes.defaults({class: 'btn btn-primary'}) }}>{{ label }}</button>
        <a href="{{ cancelUrl }}">Cancel</a>
    </div>
{% else %}
    <button type="submit" {{ attributes.defaults({class: 'btn btn-primary'}) }}>{{ label }}</button>
{% endif %}
