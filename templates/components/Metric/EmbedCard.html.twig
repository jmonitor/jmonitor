<div {{ attributes.defaults({class: 'card'}) }}>
    <div class="card-body">
        <div class="card-title mb-3 d-flex justify-content-between">
            <div class="d-flex flex-column gap-1">
                <h3 class="mb-0">{{ embed.metric.label ?? embed.metric.value }}</h3>
                {% if embed.range %}
                    <small class="d-block text-body-tertiary">{{ embed.range.label }}</small>
                {% endif %}
            </div>
            {% if embed.showProjectName %}
                <div>
                    <span class="badge bg-secondary">{{ current_project().name }}</span>
                </div>
            {% endif %}
        </div>
        {% if contentUrl %}
            {{ include('dash/embed/_embed_content.html.twig', {inner: block('content')}) }}
        {% else %}
            {{ block('content') }}
        {% endif %}
    </div>
    <div class="card-footer text-end">
        {% if preview %}
            {{ include('dash/embed/_embed_preview_controls.html.twig', {
                embed: embed,
                canAutoRefresh: is_granted('right.autorefresh'),
                showProBadge: not is_granted('right.autorefresh'),
            }) }}
        {% elseif public %}
            {# Embeddable plans are all PRO+, so auto-refresh is always allowed here. #}
            {{ include('dash/embed/_embed_controls.html.twig', {
                embed: embed,
                enabled: embed.autoRefresh,
                canAutoRefresh: true,
                showProBadge: false,
                subscribeUrl: consumed_metric_public_subscribe_url(embed.metric.component.value),
                withCredentials: false,
                contentUrl: contentUrl,
            }) }}
        {% else %}
            {# Currently unreachable: every render_embed call site passes public or preview. Kept for future in-dashboard embed cards. #}
            {{ include('dash/embed/_embed_controls.html.twig', {
                embed: embed,
                enabled: embed.autoRefresh and is_granted('right.autorefresh'),
                canAutoRefresh: is_granted('right.autorefresh'),
                showProBadge: not is_granted('right.autorefresh'),
                subscribeUrl: consumed_metric_subscribe_url(),
                withCredentials: true,
                contentUrl: null,
            }) }}
        {% endif %}
    </div>
</div>
