<twig:Metric:Help:Section icon="material-symbols:visibility" title="How to interpret this metric?">
    {% if paragraphes %}
        {% for paragraphe in paragraphes %}
            <p>{{ paragraphe|raw }}</p>
        {% endfor %}
    {% else %}
        {{ block(outerBlocks.content) }}
    {% endif %}
</twig:Metric:Help:Section>
