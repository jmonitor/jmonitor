<div class="position-relative ps-5 mb-5 {% if not enabled %}pe-none user-select-none{% endif %}">
    {{ _self.rond(step2enabled) }}

    {% if enabled %}
        {{ block('content') }}
    {% else %}
        <div class="opacity-50">
            {{ block('content') }}
        </div>
    {% endif %}
</div>

{% macro rond(enabled = true) %}
    <div class="position-absolute start-0 rounded-circle bg-body translate-middle-x p-1 mt-1" style="width: 21px; height: 21px;">
        <div class="rounded-circle border border-2 {{ enabled ? 'border-light' : 'border border-light-subtle' }} h-100"></div>
    </div>
{% endmacro %}
