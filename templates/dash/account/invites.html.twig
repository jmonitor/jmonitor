{% if invitations %}
    <ul>
        {% for invitation in invitations %}
            <li>
                <div class="d-flex align-items-center gap-3">
                    <span>Project <b>{{ invitation.project.name }}</b> as {{ invitation.role.value }}</span>
                    <a class="btn btn-primary btn-sm" href="{{ path('invitation.accept', {uniquid: invitation.uniquid}) }}">Join</a>
                    <form action="{{ path('invitation.refuse', {uniquid: invitation.uniquid}) }}" method="post" data-turbo-confirm="Please confirm.">
                        <button type="submit" class="btn link-danger">Decline</button>
                    </form>
                </div>
            </li>
        {% endfor %}
    </ul>
{% else %}
    <p>There are no pending invites.</p>
{% endif %}
