{% extends 'dash/help/metric/layout.html.twig' %}

{% block definition %}
    <p>This card shows the main PHP configuration settings that affect execution, errors, and data limits.</p>
{% endblock %}

{% block why_it_matters %}
    <p>These settings control how PHP scripts run, how errors are handled, and how much data can be processed. Wrong values can cause slow scripts, hidden errors, or failed uploads.</p>
{% endblock %}

{% block how_to_read %}
    <ul class="d-flex flex-column gap-2">
        <li>
            <twig:Html:Badge:Neutral class="fs-6">memory_limit</twig:Html:Badge:Neutral>
            <p>Maximum amount of memory a script can use. If exceeded, the script stops with an error.</p>
        </li>
        <li>
            <twig:Html:Badge:Neutral class="fs-6">max_execution_time</twig:Html:Badge:Neutral>
            <p>Maximum time (in seconds) a script is allowed to run. Prevents long or stuck processes.</p>
        </li>
        <li>
            <twig:Html:Badge:Neutral class="fs-6">display_errors</twig:Html:Badge:Neutral>
            <p>Controls whether errors are shown on screen. Should be disabled in production to avoid exposing sensitive information.</p>
        </li>
        <li>
            <twig:Html:Badge:Neutral class="fs-6">log_errors</twig:Html:Badge:Neutral>
            <p>Controls whether errors are written to a log file. Recommended to keep enabled.</p>
        </li>
        <li>
            <twig:Html:Badge:Neutral class="fs-6">error_log</twig:Html:Badge:Neutral>
            <p>Path to the file where PHP errors are logged.</p>
        </li>
        <li>
            <twig:Html:Badge:Neutral class="fs-6">error_reporting</twig:Html:Badge:Neutral>
            <p>Defines which types of errors are reported. Higher levels show more details for debugging.</p>
        </li>
        <li>
            <twig:Html:Badge:Neutral class="fs-6">post_max_size</twig:Html:Badge:Neutral>
            <p>Maximum size of data sent via POST requests. Affects form submissions and file uploads.</p>
        </li>
        <li>
            <twig:Html:Badge:Neutral class="fs-6">upload_max_filesize</twig:Html:Badge:Neutral>
            <p>Maximum allowed size for uploaded files.</p>
        </li>
        <li>
            <twig:Html:Badge:Neutral class="fs-6">date.timezone</twig:Html:Badge:Neutral>
            <p>Defines the default timezone used by PHP. Important for correct date and time handling.</p>
        </li>
    </ul>
{% endblock %}
