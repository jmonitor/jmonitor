{% extends 'dash/base.html.twig' %}

{% block title %}Join {{ invitation.project.name }}{% endblock %}

{% block content %}
<div class="max-w-xl">
    <twig:Html:H1>Invitation</twig:Html:H1>

    <p class="mt-4">
        You have been invited to join the project <b>{{ invitation.project.name }}</b>
        as <span class="badge text-bg-secondary">{{ invitation.role.value }}</span>.
    </p>

    <div class="d-flex align-items-center gap-3 mt-4">
        <form action="{{ path('invitation.accept', {uniquid: invitation.uniquid}) }}" method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('accept_invitation') }}">
            <button type="submit" class="btn btn-primary">Accept invitation</button>
        </form>
        <form action="{{ path('invitation.refuse', {uniquid: invitation.uniquid}) }}" method="post" data-turbo-confirm="Please confirm.">
            <input type="hidden" name="_token" value="{{ csrf_token('refuse_invitation') }}">
            <button type="submit" class="btn link-danger">Decline</button>
        </form>
    </div>
</div>
{% endblock %}
