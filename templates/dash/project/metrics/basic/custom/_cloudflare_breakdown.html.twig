{# dto.value: label => count ; dto.context: total, labels (raw => display), styles (raw => bar class) #}
{% set total = dto.context.total %}
{% set labels = dto.context.labels|default({}) %}
{% set styles = dto.context.styles|default({}) %}
<twig:Metric:Metric:List class="gap-3">
    {% for label, count in dto.value %}
        {% set percent = total > 0 ? (count / total * 100) : 0 %}
        <div>
            <div class="dldt">
                <div class="dl text-truncate">{{ labels[label]|default(label) }}</div>
                <div class="dt text-end text-nowrap">{{ count|number_format(0, '.', ' ') }} <span class="text-muted">· {{ percent|number_format(1) }} %</span></div>
            </div>
            <div class="progress mt-1" role="progressbar" aria-label="{{ labels[label]|default(label) }}" aria-valuenow="{{ percent|round }}" aria-valuemin="0" aria-valuemax="100" style="height: 6px">
                <div class="progress-bar {{ styles[label]|default('') }}" style="width: {{ percent|round }}%"></div>
            </div>
        </div>
    {% else %}
        <span class="text-muted">No requests over the window.</span>
    {% endfor %}
</twig:Metric:Metric:List>
