{# @var zone \App\Metrics\Dto\Bag\Cloudflare\ZoneBag #}
{% set zone = dto.value %}
{% set settings = zone.settings %}
<twig:Metric:Metric:List>
    <twig:InfoLine label="Cache level" value="{{ settings.cache_level|default('')|capitalize }}" />
    <twig:InfoLine label="Browser TTL">
        {% set ttl = settings.browser_cache_ttl|default(null) %}
        {% if ttl === 0 %}
            Respect origin headers
        {% elseif ttl is not null %}
            <span {{ stimulus_controller('duration', {seconds: ttl}) }}></span>
        {% endif %}
    </twig:InfoLine>
    <twig:InfoLine label="Always Online">{{ include('dash/project/metrics/basic/custom/_cloudflare_toggle.html.twig', {value: settings.always_online|default(null)}) }}</twig:InfoLine>
    <twig:InfoLine label="Security level" value="{{ settings.security_level|default('')|capitalize }}" />
    <twig:InfoLine label="DNS records">
        {% if zone.dnsRecordsUsed is not null %}
            {{ zone.dnsRecordsUsed }}{% if zone.dnsRecordsQuota %} / {{ zone.dnsRecordsQuota }}{% endif %}
        {% endif %}
    </twig:InfoLine>
</twig:Metric:Metric:List>
