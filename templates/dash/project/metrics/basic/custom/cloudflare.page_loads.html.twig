{# @var analytics \App\Metrics\Dto\Bag\Cloudflare\WebAnalyticsBag #}
{% set analytics = dto.value %}
<div class="d-flex align-items-baseline gap-2">
    <div class="consumer_value-value">{{ analytics.pageViews|number_format(0, '.', ' ') }}</div>
    <span class="text-muted">page loads over 24 h</span>
</div>
<twig:Metric:Metric:List class="mt-3">
    <twig:InfoLine label="Visits" value="{{ analytics.visits|number_format(0, '.', ' ') }}" />
    <twig:InfoLine label="Page load P50">{% if analytics.pageLoadP50Ms is not null %}{{ analytics.pageLoadP50Ms|format_ms }}{% endif %}</twig:InfoLine>
    <twig:InfoLine label="Page load P75">{% if analytics.pageLoadP75Ms is not null %}{{ analytics.pageLoadP75Ms|format_ms }}{% endif %}</twig:InfoLine>
</twig:Metric:Metric:List>
