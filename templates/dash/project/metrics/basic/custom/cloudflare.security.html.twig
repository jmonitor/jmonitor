{# @var window \App\Metrics\Dto\Bag\Cloudflare\WindowBag #}
{% set c = dto.context %}
<div class="d-flex align-items-baseline gap-2">
    <div class="consumer_value-value">{{ c.mitigated }}</div>
    <span class="text-muted">mitigated over {{ dto.value.spanMinutes }} min</span>
</div>
<div class="d-flex gap-2 mt-2 flex-wrap">
    {% if c.blocked > 0 %}<twig:Html:Badge:Red>{{ c.blocked }} blocked</twig:Html:Badge:Red>{% endif %}
    {% if c.challenged > 0 %}<twig:Html:Badge:Yellow>{{ c.challenged }} challenged</twig:Html:Badge:Yellow>{% endif %}
    {% if c.mitigated === 0 %}<twig:Html:Badge:Green>nothing to mitigate</twig:Html:Badge:Green>{% endif %}
</div>
<twig:Metric:Metric:List class="mt-3">
    <twig:InfoLine label="Share of requests">{% if c.share is not null %}{{ c.share }} %{% endif %}</twig:InfoLine>
    <twig:InfoLine label="Top source" value="{{ c.topSource ?? '' }}" />
</twig:Metric:Metric:List>
