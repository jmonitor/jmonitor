{# @var zone \App\Metrics\Dto\Bag\Cloudflare\ZoneBag #}
{% set settings = dto.value.settings %}
<twig:Metric:Metric:List>
    <twig:InfoLine label="SSL mode">
        {% set ssl = settings.ssl|default(null) %}
        {% if ssl in ['full', 'strict'] %}
            <twig:Html:Badge:Green>{{ ssl }}</twig:Html:Badge:Green>
        {% elseif ssl in ['flexible', 'off'] %}
            <twig:Html:Badge:Yellow>{{ ssl }}</twig:Html:Badge:Yellow>
        {% elseif ssl is not null %}
            <twig:Html:Badge:Neutral>{{ ssl }}</twig:Html:Badge:Neutral>
        {% endif %}
    </twig:InfoLine>
    <twig:InfoLine label="Always use HTTPS">
        {% set https = settings.always_use_https|default(null) %}
        {% if https === 'on' %}
            <twig:Html:Badge:Green>on</twig:Html:Badge:Green>
        {% elseif https is not null %}
            <twig:Html:Badge:Neutral>{{ https }}</twig:Html:Badge:Neutral>
        {% endif %}
    </twig:InfoLine>
    <twig:InfoLine label="Minimum TLS">{{ settings.min_tls_version|default('') }}</twig:InfoLine>
    <twig:InfoLine label="Security level">{{ settings.security_level|default('')|replace({_: ' '})|capitalize }}</twig:InfoLine>
    <twig:InfoLine label="Cache level">{{ settings.cache_level|default('')|capitalize }}</twig:InfoLine>
    <twig:InfoLine label="Browser TTL">
        {% set ttl = settings.browser_cache_ttl|default(null) %}
        {% if ttl === 0 %}
            Respect origin headers
        {% elseif ttl is not null %}
            <span {{ stimulus_controller('duration', {seconds: ttl}) }}></span>
        {% endif %}
    </twig:InfoLine>
</twig:Metric:Metric:List>
