{# @var zone \App\Metrics\Dto\Bag\Cloudflare\ZoneBag #}
{% set settings = dto.value.settings %}
<twig:Metric:Metric:List>
    <twig:InfoLine label="SSL mode">
        {% set ssl = settings.ssl|default(null) %}
        {% if ssl in ['full', 'strict'] %}
            <twig:Html:Badge:Green>{{ ssl }}</twig:Html:Badge:Green>
        {% elseif ssl in ['flexible', 'off'] %}
            <twig:Html:Badge:Yellow>{{ ssl }}</twig:Html:Badge:Yellow>
        {% elseif ssl is not null %}
            <twig:Html:Badge:Neutral>{{ ssl }}</twig:Html:Badge:Neutral>
        {% endif %}
    </twig:InfoLine>
    <twig:InfoLine label="Minimum TLS" value="{{ settings.min_tls_version|default('') }}" />
    <twig:InfoLine label="Always use HTTPS">{{ include('dash/project/metrics/basic/custom/_cloudflare_toggle.html.twig', {value: settings.always_use_https|default(null)}) }}</twig:InfoLine>
    <twig:InfoLine label="HTTP/3">{{ include('dash/project/metrics/basic/custom/_cloudflare_toggle.html.twig', {value: settings.http3|default(null)}) }}</twig:InfoLine>
    <twig:InfoLine label="Brotli">{{ include('dash/project/metrics/basic/custom/_cloudflare_toggle.html.twig', {value: settings.brotli|default(null)}) }}</twig:InfoLine>
    <twig:InfoLine label="Early hints">{{ include('dash/project/metrics/basic/custom/_cloudflare_toggle.html.twig', {value: settings.early_hints|default(null)}) }}</twig:InfoLine>
    <twig:InfoLine label="0-RTT">{{ include('dash/project/metrics/basic/custom/_cloudflare_toggle.html.twig', {value: settings['0rtt']|default(null)}) }}</twig:InfoLine>
</twig:Metric:Metric:List>
