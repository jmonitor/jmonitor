{# @var dto \App\Metrics\Renderer\Dto\BasicDto #}
<twig:Metric:Metric:List>
    <twig:InfoLine label="Data">{{ dto.value['data_length']|format_bytes }}</twig:InfoLine>
    <twig:InfoLine label="Index">{{ dto.value['index_length']|format_bytes }}</twig:InfoLine>
    <twig:InfoLine label="Total">{{ dto.value['total_length']|format_bytes }}</twig:InfoLine>
</twig:Metric:Metric:List>
