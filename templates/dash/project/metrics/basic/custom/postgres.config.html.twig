{# @var settings \App\Metrics\Dto\Bag\Postgres\PostgresSettingsBag #}
{% set settings = dto.value %}

<twig:Metric:Metric:List class="mh-15 overflow-y-auto pe-2">
    <twig:InfoLine label="max_connections" value="{{ settings.maxConnections }}" />
    <twig:InfoLine label="effective_cache_size">{{ settings.effectiveCacheSize|format_bytes }}</twig:InfoLine>
    <twig:InfoLine label="work_mem">{{ settings.workMem|format_bytes }}</twig:InfoLine>
    <twig:InfoLine label="maintenance_work_mem">{{ settings.maintenanceWorkMem|format_bytes }}</twig:InfoLine>

    <hr>
    <twig:InfoLine label="wal_level" value="{{ settings.walLevel }}" />
    <twig:InfoLine label="max_wal_size">{{ settings.maxWalSize|format_bytes }}</twig:InfoLine>
    <twig:InfoLine label="checkpoint_completion_target" value="{{ settings.checkpointCompletionTarget }}" />
</twig:Metric:Metric:List>
