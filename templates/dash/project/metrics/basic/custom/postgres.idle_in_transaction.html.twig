{# @var bag \App\Metrics\Dto\Bag\Postgres\PostgresActivityBag #}
{% set bag = dto.value %}

<div class="d-flex align-items-baseline gap-2">
    <span class="display-6 {{ bag.idleInTransactionCount > 0 ? 'text-warning' : '' }}">{{ bag.idleInTransactionCount }}</span>
    <span class="text-muted">transactions left open by the app</span>
</div>
{% if bag.oldestIdleInTransactionSeconds is not null %}
    <div class="text-muted text-sm mt-1">Oldest: {{ bag.oldestIdleInTransactionSeconds }}s</div>
{% endif %}
