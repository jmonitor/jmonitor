{# @var bag \App\Metrics\Dto\Bag\Postgres\PostgresActivityBag #}
{% set bag = dto.value %}

{% if bag.oldestTransactionSeconds is not null %}
    <div class="display-6">{{ bag.oldestTransactionSeconds }}s</div>
    <div class="text-muted text-sm mt-1">Longest running transaction</div>
{% else %}
    <div class="text-muted">No active transaction</div>
{% endif %}
