{# @var dto \App\Metrics\Renderer\Dto\GaugeDto #}
<twig:Card {{ ...attributes.defaults({class: 'card-metric'}) }}>
    <div class="position-absolute top-0 end-0 p-2">
        {% if dto %} {# if length actions ? #}
            <twig:Metric:Actions dto="{{ dto }}" renderer="{{ renderer }}" />
        {% endif %}
    </div>

    <twig:Metric metric="{{ metric.value }}" renderer="{{ renderer.value }}" options="{{ options }}" />
</twig:Card>
