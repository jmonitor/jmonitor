{# @var bag \App\Metrics\Dto\Bag\Cloudflare\CloudflareBag #}
{% extends 'dash/project/metric_layout.twig' %}

{% block metric_content %}
    {% if bag.isCollectorDown %}
        <div class="row g-4">
            <div class="col-12">
                <twig:Metric:Card metric="cloudflare.zone" class="h-100"/>
            </div>
        </div>
    {% else %}
        <div class="row g-4">
            <div class="col-md-6 col-xxl-3">
                <twig:Metric:Card metric="cloudflare.zone" class="h-100"/>
            </div>
            <div class="col-md-6 col-xxl-3">
                <twig:Metric:Card metric="cloudflare.certificate" class="h-100"/>
            </div>
            <div class="col-md-6 col-xxl-3">
                <twig:Metric:Card metric="cloudflare.settings" class="h-100"/>
            </div>
            <div class="col-md-6 col-xxl-3">
                <twig:Metric:Card metric="cloudflare.cache_settings" class="h-100"/>
            </div>
        </div>

        <twig:Html:Metrics:H2 :bag="bag">Quick view <small class="text-muted fw-light fs-6">last 15 minutes at the edge</small></twig:Html:Metrics:H2>

        <div class="row g-4">
            <div class="col-md-6 col-xxl-3">
                <twig:Metric:Card metric="cloudflare.requests" class="h-100"/>
            </div>
            <div class="col-md-6 col-xxl-3">
                <twig:Metric:Card metric="cloudflare.cache_hit_ratio" renderer="gauge" class="h-100" cardBody:class="d-flex flex-column justify-content-center"/>
            </div>
            <div class="col-md-6 col-xxl-3">
                <twig:Metric:Card metric="cloudflare.origin_response_time" class="h-100"/>
            </div>
            <div class="col-md-6 col-xxl-3">
                <twig:Metric:Card metric="cloudflare.security" class="h-100"/>
            </div>
        </div>

        <twig:Cards :titles="['Traffic', 'Security', 'Web Analytics', 'Storage']" memory="true" class="mt-4">
            {% block block_1 %}
                <twig:Html:Metrics:H2 :bag="bag" :showRange="true">Traffic</twig:Html:Metrics:H2>
                <div class="row g-4">
                    <div class="col-xl-8">
                        <twig:Metric:Card metric="cloudflare.requests" renderer="line" class="h-100"/>
                    </div>
                    <div class="col-xl-4">
                        <twig:Metric:Card metric="cloudflare.bandwidth" class="h-100"/>
                    </div>
                </div>
                <div class="row g-4 mt-0">
                    {% for metric in ['cloudflare.by_cache_status', 'cloudflare.by_status', 'cloudflare.by_country', 'cloudflare.by_content_type', 'cloudflare.by_protocol', 'cloudflare.by_host'] %}
                        <div class="col-md-6 col-xxl-4">
                            <twig:Metric:Card metric="{{ metric }}" class="h-100"/>
                        </div>
                    {% endfor %}
                </div>

                <twig:Html:Metrics:H2 :bag="bag">Today</twig:Html:Metrics:H2>
                <div class="row g-4">
                    <div class="col-12">
                        <twig:Metric:Card metric="cloudflare.today"/>
                    </div>
                </div>

                <twig:Html:Metrics:H2 :bag="bag" :showRange="true">Origin</twig:Html:Metrics:H2>
                <div class="row g-4">
                    <div class="col-xl-8">
                        <twig:Metric:Card metric="cloudflare.origin_response_time" renderer="line" class="h-100"/>
                    </div>
                    <div class="col-xl-4">
                        <twig:Metric:Card metric="cloudflare.origin_requests" class="h-100"/>
                    </div>
                </div>
            {% endblock %}

            {% block block_2 %}
                <twig:Html:Metrics:H2 :bag="bag">Security <small class="text-muted fw-light fs-6">last 15 minutes</small></twig:Html:Metrics:H2>
                <div class="row g-4">
                    <div class="col-xl-6">
                        <twig:Metric:Card metric="cloudflare.security_by_action" class="h-100"/>
                    </div>
                    <div class="col-xl-6">
                        <twig:Metric:Card metric="cloudflare.security_by_source" class="h-100"/>
                    </div>
                </div>

                <twig:Html:Metrics:H2 :bag="bag" :showRange="true">Errors</twig:Html:Metrics:H2>
                <div class="row g-4">
                    <div class="col-12">
                        <twig:Metric:Card metric="cloudflare.error_ratio"/>
                    </div>
                </div>
            {% endblock %}

            {% block block_3 %}
                <twig:Html:Metrics:H2 :bag="bag">Web Analytics <small class="text-muted fw-light fs-6">real visitors, last 24 hours</small></twig:Html:Metrics:H2>
                <div class="row g-4">
                    <div class="col-xl-8">
                        <twig:Metric:Card metric="cloudflare.web_vitals" class="h-100"/>
                    </div>
                    <div class="col-xl-4">
                        <twig:Metric:Card metric="cloudflare.page_loads" class="h-100"/>
                    </div>
                </div>
                <div class="row g-4 mt-0">
                    <div class="col-xl-6">
                        <twig:Metric:Card metric="cloudflare.web_analytics_by_host" class="h-100"/>
                    </div>
                    <div class="col-xl-6">
                        <twig:Metric:Card metric="cloudflare.timings" class="h-100"/>
                    </div>
                </div>
            {% endblock %}

            {% block block_4 %}
                <twig:Html:Metrics:H2 :bag="bag">Storage <small class="text-muted fw-light fs-6">account level, Free plan quotas</small></twig:Html:Metrics:H2>
                <div class="row g-4">
                    <div class="col-xl-6">
                        <twig:Metric:Card metric="cloudflare.r2" class="h-100"/>
                    </div>
                    <div class="col-xl-6">
                        <twig:Metric:Card metric="cloudflare.images" class="h-100"/>
                    </div>
                </div>
            {% endblock %}
        </twig:Cards>
    {% endif %}
{% endblock %}
