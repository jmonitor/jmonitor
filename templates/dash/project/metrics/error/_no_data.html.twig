<div class="text-muted text-center justify-content-around">
    <div class="d-flex align-items-center gap-2 lh-1">
        <span class="fw-light text-uppercase">No data</span>
        <twig:HelpIcon item="no_data"></twig:HelpIcon>
    </div>
    {% if reason|default %}
        <p class="text-start mt-2 mb-0">{{ reason }}</p>
    {% elseif mode.value === 'extended' %}
        <p class="text-center">
            Maybe...<br>
            - It's not ready yet,<br>
            - You didn't send it,<br>
            - Something else.
        </p>
    {% endif %}
</div>
