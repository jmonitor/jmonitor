<twig:Metric:Metric:Gauge dto="{{ dto }}" chart="{{ chart }}" options="{{ options }}">
    {% if dto.context.bytesPercent is defined and dto.context.bytesPercent is not null %}
        {{ dto.context.bytesPercent }} % of bytes served from cache over the last {{ dto.context.bytesMinutes }} min
    {% endif %}
</twig:Metric:Metric:Gauge>
