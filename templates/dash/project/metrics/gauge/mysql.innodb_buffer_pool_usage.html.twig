{# @var status \App\Metrics\Dto\Bag\Mysql\MysqlStatusBag #}
{# @var variables \App\Metrics\Dto\Bag\Mysql\MysqlVariableBag #}
{# @var dto \App\Metrics\Renderer\Dto\GaugeDto #}
<twig:Metric:Metric:Gauge dto="{{ dto }}" chart="{{ chart }}" options="{{ options }}">
    {% if dto.context.innodbBufferPoolBytesFree !== null and dto.context.innoDbBufferPoolSize > 0 %}
        {{ dto.context.innodbBufferPoolBytesFree|format_bytes }} / {{ dto.context.innoDbBufferPoolSize|format_bytes }}
    {% else %}
        {{ dto.context.innoDbPagesUsedBytes|format_bytes }} / {{ dto.context.innoDbPagesTotalBytes|format_bytes }}
    {% endif %}
</twig:Metric:Metric:Gauge>
