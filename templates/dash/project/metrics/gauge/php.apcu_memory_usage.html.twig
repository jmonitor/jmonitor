{# @var bag \App\Metrics\Dto\Bag\Php\PhpBag #}
{# @var dto \App\Metrics\Renderer\Dto\GaugeDto #}
<twig:Metric:Metric:Gauge dto="{{ dto }}" chart="{{ chart }}" options="{{ options }}">
    {% if bag.apcu.sma.usedMem is not null and bag.apcu.sma.totalMem > 0 %}
        {{ bag.apcu.sma.usedMem|format_bytes }} / {{ bag.apcu.sma.totalMem|format_bytes }}
    {% endif %}
</twig:Metric:Metric:Gauge>
