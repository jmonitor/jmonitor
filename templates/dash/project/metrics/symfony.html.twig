{% extends 'dash/project/metric_layout.twig' %}

{% block metric_content %}
    <div class="row g-4">
        <div class="col-xxl-4">
            <div class="d-flex flex-column flex-sm-row flex-xxl-column gap-4 h-100">
                <twig:Metric:Card metric="symfony.version" class="flex-fill"/>
                <twig:Metric:Card metric="symfony.environment" class="flex-fill"/>
            </div>
        </div>
        <div class="col-xl-6 col-xxl-4">
            <twig:Metric:Card metric="symfony.config_bundles" class="h-100"/>
        </div>
        <div class="col-xl-6 col-xxl-4">
            <twig:Metric:Card metric="symfony.flex" class="h-100"/>
        </div>
    </div>

    <twig:Html:Metrics:H2 bag="{{ bag }}">Components</twig:Html:Metrics:H2>

    <div class="row g-4">
        <div class="col-lg-6">
            <twig:Metric:Card metric="symfony.messenger" class="h-100"/>
        </div>
        <div class="col-lg-6">
            <twig:Metric:Card metric="symfony.scheduler_next_task" class="h-100"/>
        </div>
    </div>

    <twig:Metric:Card metric="symfony.scheduler_tasks" class="card-transparent"/>
{% endblock %}
