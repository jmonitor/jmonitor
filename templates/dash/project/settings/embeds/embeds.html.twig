{% extends 'dash/project/settings_layout.twig' %}

{% block title %}Embeds{% endblock %}

{% block settings_content %}
    {% set can_edit = is_granted('project.admin') %}

    <twig:Alert type="warning" class="mb-0">
        Anyone with an embed link can view the embedded metric without logging in.
        Delete a link to cut off access immediately.
    </twig:Alert>

    <twig:Cards title="Embed links">
        <twig:Card>
            {% if embeds is empty %}
                <p class="text-body-tertiary mb-0">
                    No embed link yet. Open a metric card menu and choose <b>Embed</b> to create one.
                </p>
            {% else %}
                <table class="table table-borderless align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col"><small class="text-body-tertiary fw-normal">Metric</small></th>
                            <th scope="col"><small class="text-body-tertiary fw-normal">Created</small></th>
                            <th scope="col"><small class="text-body-tertiary fw-normal">Last used</small></th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in embeds %}
                            {% set dto = item.dto %}
                            {% set embed_url = url('embed.public', {token: item.token}) %}
                            <tr>
                                <td>{{ dto.metric.label ?? dto.metric.value }}</td>
                                <td>
                                    {{ item.createdAt|date('Y-m-d') }}
                                    {% if item.createdBy %}<small class="d-block text-body-tertiary">by {{ item.createdBy.email }}</small>{% endif %}
                                </td>
                                <td>{{ item.lastUsedAt ? item.lastUsedAt|date('Y-m-d H:i') : 'never' }}</td>
                                <td class="text-end">
                                    {% if not can_edit %}
                                        <twig:Html:Dropdown :disabled="true" />
                                    {% else %}
                                        <twig:Html:Dropdown
                                            data-controller="clipboard"
                                            data-clipboard-success-content-value="Copied!"
                                        >
                                            <li>
                                                <span hidden data-clipboard-target="source">{{ embed_url }}</span>
                                                <button
                                                    type="button"
                                                    class="dropdown-item"
                                                    data-clipboard-target="button"
                                                    data-action="clipboard#copy"
                                                >Copy link</button>
                                            </li>
                                            <li>
                                                <form
                                                    action="{{ path('project.settings.embeds.delete', {uuid: current_project().uuid, token: item.token}) }}"
                                                    method="post"
                                                    data-turbo-confirm="Please confirm"
                                                >
                                                    <input type="hidden" name="_token" value="{{ csrf_token('embed-action') }}">
                                                    <button type="submit" class="dropdown-item link-danger">Delete</button>
                                                </form>
                                            </li>
                                        </twig:Html:Dropdown>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </twig:Card>
    </twig:Cards>
{% endblock %}
