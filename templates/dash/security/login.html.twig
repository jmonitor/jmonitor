{% extends 'dash/base_login.html.twig' %}

{% block title %}Login{% endblock %}

{% block h1 %}Login{% endblock %}
{% block sub_h1 %}
    {{ 'login.not_registred?'|trans }} <a href="{{ path('security.register') }}">Register</a>
{% endblock %}

{% do metas().canonical('security.login') %}

{% block content %}
    {% if error %}
        <twig:Alert type="danger">{{ error.messageKey|trans(error.messageData, 'security') }}</twig:Alert>
    {% endif %}

    <twig:Security:OauthLinks />
    <twig:Security:Ou />

    <form action="{{ path('security.login.check') }}" method="post" data-turbo="false">
        <div class="mb-4">
            <label class="form-label" for="username">Email</label>
            <input type="text" id="username" name="_username" value="{{ last_username }}" class="form-control form-control-lg" autocomplete="email" required/>
        </div>

        <div class="mb-4">
            <label class="form-label" for="password">Password</label>
            <input type="password" id="password" name="_password" class="form-control form-control-lg" required autocomplete="current-password" />
            <div class="text-end"><small><a href="{{ path('security.password_lost') }}">Forgot password</a></small></div>
        </div>

        <div class="mb-3">
            <button type="submit" class="btn btn-primary w-100">Log in</button>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}" {{ stimulus_controller('csrf-protection') }} />
    </form>

    <twig:Security:Terms />
{% endblock %}
