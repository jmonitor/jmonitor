{% extends 'dash/base_login.html.twig' %}

{% block title %}Password lost{% endblock %}

{% do metas().robots('noindex') %}

{% block h1 %}Password lost{% endblock %}
{% block sub_h1 %}{{ 'password_lost.intro'|trans }}{% endblock %}

{% block content %}
    {% if checkEmail %}
        <twig:Alert type="success">{{ 'password_lost.check_mail'|trans }}</twig:Alert>
    {% else %}
        {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_rest(form) }}
        <button class="btn btn-primary w-100" type="submit">{{ 'password_lost.submit'|trans }}</button>
        {{ form_end(form) }}
    {% endif %}

    <p class="mt-5"><a href="{{ path('security.login') }}">{{ 'password_lost.back_to_login'|trans }}</a></p>
{% endblock %}
