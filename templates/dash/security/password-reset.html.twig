{% extends 'dash/base_login.html.twig' %}

{% block title %}Reset password{% endblock %}

{% do metas().robots('noindex') %}

{% block h1 %}Chose a new password{% endblock %}

{% block content %}
    <div data-turbo="false">
        {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_rest(form) }}
        <button class="btn btn-primary" type="submit">Save</button>
        {{ form_end(form) }}
    </div>
{% endblock %}
