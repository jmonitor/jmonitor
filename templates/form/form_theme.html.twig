{% extends 'bootstrap_5_layout.html.twig' %}

{# Change the default mb-3 to mb-4 #}
{%- block form_row -%}
    {%- set row_class = row_class|default(row_attr.class|default('mb-4')|trim) -%}

    {{ parent() }}
{%- endblock form_row %}

{% block byte_unit_widget %}
    <div class="input-group">
        {{ form_widget(form.value) }}
        {{ form_widget(form.unit, {attr: {style: 'max-width: 100px'}}) }}
    </div>
{% endblock %}

{% block ms_unit_widget %}
    <div class="input-group">
        {{ form_widget(form.value) }}
        {{ form_widget(form.unit, {attr: {style: 'max-width: 100px'}}) }}
    </div>
{% endblock %}

{# Same row wrapper as bootstrap_5_layout's form_row/form_row_render (aria wiring, help, errors),
   with the label line replaced by a label + live value readout, per the slider's own needs. #}
{% block slider_row %}
    {%- set attr = {} -%}
    {%- set aria_describedby = [] -%}
    {%- if help -%}
        {%- set aria_describedby = aria_describedby|merge([id ~ '_help']) -%}
    {%- endif -%}
    {%- if errors|length > 0 -%}
        {%- set aria_describedby = aria_describedby|merge(errors|map((_, index) => id ~ '_error' ~ (index + 1))) -%}
    {%- endif -%}
    {%- if aria_describedby|length > 0 -%}
        {%- set attr = attr|merge({'aria-describedby': aria_describedby|join(' ')}) -%}
    {%- endif -%}
    {%- if errors|length > 0 -%}
        {%- set attr = attr|merge({'aria-invalid': 'true'}) -%}
    {%- endif -%}
    {%- set row_class = row_class|default(row_attr.class|default('mb-4')|trim) -%}
    <div{% with {attr: row_attr|merge({class: row_class})} %}{{ block('attributes') }}{% endwith %} {{ stimulus_controller('option-slider', {default: default}) }}>
        <div class="d-flex justify-content-between align-items-baseline">
            {{ form_label(form) }}
            <small class="text-body-tertiary">
                <span data-option-slider-target="value">{{ value }}</span>
                <span data-option-slider-target="badge">(default)</span>
                <button type="button" class="btn btn-link btn-sm p-0 ms-1 d-none"
                        data-option-slider-target="reset"
                        data-action="option-slider#reset"
                        title="Reset to default">↺</button>
            </small>
        </div>
        {{ form_widget(form, {attr: attr}) }}
        {{ form_help(form) }}
        {{ form_errors(form) }}
    </div>
{% endblock %}
