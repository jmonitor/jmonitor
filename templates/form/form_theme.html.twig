{% extends 'bootstrap_5_layout.html.twig' %}

{# Change the default mb-3 to mb-4 #}
{%- block form_row -%}
    {%- set row_class = row_class|default(row_attr.class|default('mb-4')|trim) -%}

    {{ parent() }}
{%- endblock form_row %}

{% block byte_unit_widget %}
    <div class="input-group">
        {{ form_widget(form.value) }}
        {{ form_widget(form.unit, {attr: {style: 'max-width: 100px'}}) }}
    </div>
{% endblock %}

{% block ms_unit_widget %}
    <div class="input-group">
        {{ form_widget(form.value) }}
        {{ form_widget(form.unit, {attr: {style: 'max-width: 100px'}}) }}
    </div>
{% endblock %}

{% block slider_row %}
    <div class="mb-4" {{ stimulus_controller('option-slider', {default: default}) }}>
        <div class="d-flex justify-content-between align-items-baseline">
            {{ form_label(form) }}
            <small class="text-body-tertiary">
                <span data-option-slider-target="value">{{ value }}</span>
                <span data-option-slider-target="badge">(default)</span>
                <button type="button" class="btn btn-link btn-sm p-0 ms-1 d-none"
                        data-option-slider-target="reset"
                        data-action="option-slider#reset"
                        title="Reset to default">↺</button>
            </small>
        </div>
        {{ form_widget(form) }}
    </div>
{% endblock %}
