<ul class="nav nav-pills flex-column gap-3">
    {% for link in links %}
        <li class="nav-item">
            <a class="nav-link py-2 d-flex align-items-center rounded gap-2 {% if link.isActive(app.request) %}active{% endif %}" href="{{ path(link.routeName, link.routeParameters) }}">
                {{ ux_icon(link.metadata('icon'), {height: '1.3em', width: '1.3em'}) }}
                {{ link.label }}
            </a>
        </li>
    {% endfor %}
</ul>
